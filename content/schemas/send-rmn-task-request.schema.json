{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsenn.github.io/a2a-rmn-hire-and-verify-cell/schemas/send-rmn-task-request.schema.json",
  "title": "Send RMN A2A task request",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "agentCard", "inputNi", "authorization", "nonce", "deadline"],
  "properties": {
    "profile": {"const": "org.emsenn.a2a-rmn-hire-request.v1"},
    "agentCard": {"type": "string", "format": "uri"},
    "inputNi": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "authorization": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "deadline": {"type": "string", "format": "date-time"},
    "requiredExtensions": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true,
      "maxItems": 16
    }
  }
}

