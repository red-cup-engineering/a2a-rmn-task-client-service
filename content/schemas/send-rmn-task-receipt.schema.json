{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsenn.github.io/a2a-rmn-hire-and-verify-cell/schemas/send-rmn-task-receipt.schema.json",
  "title": "Verified RMN A2A task receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "request", "provider", "task", "inputNi", "outputNi", "authorization"],
  "properties": {
    "profile": {"const": "org.emsenn.a2a-rmn-hire-receipt.v1"},
    "request": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
    "provider": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "inputNi": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
    "outputNi": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
    "authorization": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}
  }
}

